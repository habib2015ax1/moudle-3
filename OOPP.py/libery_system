class Book:
    def __init__(self, title):
        self.title = title
        self.borrowed = False

    def borrow(self):
        self.borrowed = True

    def return_book(self):
        self.borrowed = False

    def __str__(self):
        return self.title

b = Book("Harry Potter")
b.borrow()
print(b, b.borrowed)
b.return_book()
print(b, b.borrowed)